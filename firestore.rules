rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isHumanAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return isHumanAccount() && request.auth.token.admin == true;
    }

    function session(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId));
    }

    function manages(sessionId) {
      return isAdmin() || (isHumanAccount() && session(sessionId).data.ownerUid == request.auth.uid);
    }

    function managesAfter(sessionId) {
      return isAdmin() || (isHumanAccount()
        && getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerUid == request.auth.uid);
    }

    function validExperience(value) {
      return value in ['Beginner', 'Experienced', 'Expert'];
    }

    function validRoster() {
      return request.resource.data.keys().hasOnly(['displayName', 'experience', 'interestStatus', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && validExperience(request.resource.data.experience)
        && request.resource.data.interestStatus in ['confirmed', 'maybe', 'waitlist'];
    }

    function validScriptData(value) {
      return value == null || (
        value is map
        && value.keys().hasOnly(['name', 'author', 'characters'])
        && value.name is string
        && value.name.size() <= 100
        && value.author is string
        && value.author.size() <= 80
        && value.characters is list
        && value.characters.size() <= 80
      );
    }

    function validSession() {
      return request.resource.data.keys().hasOnly([
        'ownerUid', 'organizerName', 'storytellerNames', 'title', 'location', 'notes', 'capacity', 'difficulty',
        'visibility', 'status', 'fixedDate', 'selectedDate', 'selectedOptionId',
        'dateOptions', 'scriptMode', 'scriptName', 'scriptUrl', 'scriptData', 'inviteSlug', 'timezone', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.ownerUid is string
      && request.resource.data.organizerName is string
      && request.resource.data.organizerName.size() <= 60
      && (!request.resource.data.keys().hasAny(['storytellerNames'])
        || (request.resource.data.storytellerNames is string
          && request.resource.data.storytellerNames.size() >= 2
          && request.resource.data.storytellerNames.size() <= 160))
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 80
      && request.resource.data.location is string
      && request.resource.data.location.size() <= 120
      && request.resource.data.notes is string
      && request.resource.data.notes.size() <= 600
      && request.resource.data.capacity is int
      && request.resource.data.capacity >= 5
      && request.resource.data.capacity <= 20
      && (!request.resource.data.keys().hasAny(['difficulty'])
        || request.resource.data.difficulty in ['Beginner', 'Experienced', 'Expert'])
      && request.resource.data.visibility == 'public'
      && request.resource.data.status in ['date_poll', 'find_players', 'closed', 'cancelled', 'archived']
      && (!request.resource.data.keys().hasAny(['timezone'])
        || (request.resource.data.timezone is string && request.resource.data.timezone.size() <= 60))
      && request.resource.data.scriptMode in ['tbd', 'chosen']
      && (!request.resource.data.keys().hasAny(['scriptData']) || validScriptData(request.resource.data.scriptData))
      && request.resource.data.inviteSlug is string
      && request.resource.data.inviteSlug.size() >= 4
      && request.resource.data.inviteSlug.size() <= 48
      && request.resource.data.dateOptions is list
      && request.resource.data.dateOptions.size() <= 10;
    }

    function validPlannedScript() {
      return request.resource.data.keys().hasOnly([
        'name', 'author', 'edition', 'sourceType', 'pdfUrl', 'scriptData', 'order', 'preferred', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 100
      && request.resource.data.author is string
      && request.resource.data.author.size() <= 80
      && (!request.resource.data.keys().hasAny(['edition'])
        || request.resource.data.edition in ['', 'tb', 'bmr', 'snv'])
      && request.resource.data.sourceType == 'json'
      && request.resource.data.pdfUrl is string
      && request.resource.data.pdfUrl == ''
      && (!request.resource.data.keys().hasAny(['order']) || request.resource.data.order is int)
      && (!request.resource.data.keys().hasAny(['preferred']) || request.resource.data.preferred is bool)
      && request.resource.data.scriptData is map
      && validScriptData(request.resource.data.scriptData);
    }

    // IDP-compatible human-readable links. Direct session-ID links remain valid.
    match /inviteLinks/{slug} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isHumanAccount()
        && request.resource.data.keys().hasOnly(['sessionId', 'ownerUid', 'createdAt', 'updatedAt'])
        && ((request.resource.data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.ownerUid == request.auth.uid)
          || (isAdmin()
            && getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.ownerUid == request.resource.data.ownerUid));
      allow update: if isAdmin() || (isHumanAccount()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.sessionId == resource.data.sessionId);
      allow delete: if isAdmin() || (isHumanAccount() && resource.data.ownerUid == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isHumanAccount()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'role', 'createdAt'])
        && request.resource.data.role == 'organizer';
      allow update: if isHumanAccount()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email;
      allow delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow get: if resource.data.visibility == 'public' || manages(sessionId);
      allow list: if isAdmin()
        || (isHumanAccount() && resource.data.ownerUid == request.auth.uid)
        || resource.data.visibility == 'public';
      allow create: if isHumanAccount()
        && request.resource.data.ownerUid == request.auth.uid
        && validSession();
      allow update: if manages(sessionId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validSession();
      allow delete: if manages(sessionId);

      // Public planned scripts contain only display data. Only session managers write them.
      match /scripts/{scriptId} {
        allow read: if session(sessionId).data.visibility == 'public' || manages(sessionId);
        allow create, update: if managesAfter(sessionId) && validPlannedScript();
        allow delete: if manages(sessionId);
      }

      // Private player record. Public visitors cannot list or read these docs.
      match /registrations/{playerId} {
        allow read: if signedIn() && (resource.data.createdByUid == request.auth.uid || manages(sessionId));
        allow create: if signedIn()
          && (request.resource.data.createdByUid == request.auth.uid || manages(sessionId))
          && (manages(sessionId) || session(sessionId).data.status in ['date_poll', 'find_players'])
          && request.resource.data.keys().hasOnly(['displayName', 'experience', 'createdByUid', 'responses', 'finalStatus', 'updatedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 2
          && request.resource.data.displayName.size() <= 40
          && validExperience(request.resource.data.experience);
        allow update: if (signedIn()
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'responses', 'updatedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 2
          && request.resource.data.displayName.size() <= 40
          && (session(sessionId).data.status == 'date_poll'
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['responses']))
          && (!request.resource.data.keys().hasAny(['responses']) || request.resource.data.responses is map))
          || (manages(sessionId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finalStatus', 'updatedAt']));
        allow delete: if manages(sessionId);
      }

      // Anonymous response documents deliberately contain no name or contact data.
      match /dateOptions/{optionId}/responses/{playerId} {
        allow read: if session(sessionId).data.visibility == 'public';
        allow create, update: if signedIn()
          && (manages(sessionId)
            || getAfter(/databases/$(database)/documents/sessions/$(sessionId)/registrations/$(playerId)).data.createdByUid == request.auth.uid)
          && session(sessionId).data.status == 'date_poll'
          && request.resource.data.keys().hasOnly(['response', 'updatedAt'])
          && request.resource.data.response in ['available', 'maybe', 'unavailable'];
        allow delete: if manages(sessionId);
      }

      // The public roster contains only explicitly consented display fields.
      match /roster/{playerId} {
        allow read: if session(sessionId).data.visibility == 'public';
        allow create: if (
          manages(sessionId)
          || (signedIn()
            && session(sessionId).data.status == 'find_players'
            && getAfter(/databases/$(database)/documents/sessions/$(sessionId)/registrations/$(playerId)).data.createdByUid == request.auth.uid)
        )
        && validRoster();
        allow update: if validRoster() && (
          manages(sessionId)
          || (signedIn()
            && session(sessionId).data.status == 'find_players'
            && get(/databases/$(database)/documents/sessions/$(sessionId)/registrations/$(playerId)).data.createdByUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );
        allow delete: if manages(sessionId);
      }
    }
  }
}
